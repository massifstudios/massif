// Hydraulic (virtual pipes, Mei et al. 2007) and thermal erosion kernels.
// All heights/water in meters, cell size in meters, one thread per cell.

#include "/Engine/Public/Platform.ush"

Texture2D<float> TerrainIn;
Texture2D<float> WaterIn;
Texture2D<float> SedimentIn;
Texture2D<float> ExchangeIn;
Texture2D<float> ExchangeBlurIn;
Texture2D<float> SourceIn;
Texture2D<float4> FluxIn;
Texture2D<float2> VelocityIn;

RWTexture2D<float> TerrainOut;
RWTexture2D<float> WaterOut;
RWTexture2D<float> SedimentOut;
RWTexture2D<float> ExchangeOut;
RWTexture2D<float> SourceOut;
RWTexture2D<float4> FluxOut;
RWTexture2D<float2> VelocityOut;

struct FRiverSourceEntry
{
	int2 Cell;
	float RateMetersPerSecond;
	float Padding;
};

StructuredBuffer<FRiverSourceEntry> RiverSources;
uint RiverSourceCount;
int RiverSourceRadius;

uint2 GridSize;
float CellSizeMeters;
float DeltaTime;
float RainRate;
float EvaporationRate;
float PipeCrossSection;
float Gravity;
float SedimentCapacityFactor;
float DissolveRate;
float DepositRate;
float TalusTangent;
float ThermalRate;
float MaxWaterSpeed;
float MaxErosionPerStep;
float FluxDamping;
float MinFlowDepth;
float MinErosionWaterDepth;
float ErosionEdgeFadeCells;
int ErosionBrushRadius;

static const int2 NeighborOffsets[4] =
{
	int2(-1, 0), int2(1, 0), int2(0, -1), int2(0, 1)
};

bool IsInside(int2 Cell)
{
	return Cell.x >= 0 && Cell.y >= 0 && Cell.x < (int)GridSize.x && Cell.y < (int)GridSize.y;
}

// ---------------------------------------------------------------------------
// Setup: stamp the spring sources into the per-cell inflow map, once per run.

void WriteSourceDisc(int2 Center, float RateMetersPerSecond)
{
	const int Diameter = 2 * RiverSourceRadius + 1;
	const int DiscCellCount = Diameter * Diameter;
	for (int Index = 0; Index < DiscCellCount; ++Index)
	{
		const int2 Offset = int2(Index % Diameter, Index / Diameter) - RiverSourceRadius;
		const int2 Cell = Center + Offset;
		const bool bInsideDisc = dot(Offset, Offset) <= RiverSourceRadius * RiverSourceRadius;
		if (bInsideDisc && IsInside(Cell))
		{
			SourceOut[Cell] = RateMetersPerSecond;
		}
	}
}

[numthreads(64, 1, 1)]
void SeedRiverSourcesCS(uint3 ThreadId : SV_DispatchThreadID)
{
	if (ThreadId.x >= RiverSourceCount)
	{
		return;
	}
	const FRiverSourceEntry Source = RiverSources[ThreadId.x];
	WriteSourceDisc(Source.Cell, Source.RateMetersPerSecond);
}

// ---------------------------------------------------------------------------
// Pass 1: rain and spring inflow.
[numthreads(8, 8, 1)]
void AddWaterCS(uint3 ThreadId : SV_DispatchThreadID)
{
	if (ThreadId.x >= GridSize.x || ThreadId.y >= GridSize.y)
	{
		return;
	}
	const float InflowRate = RainRate + SourceIn[ThreadId.xy];
	WaterOut[ThreadId.xy] = WaterIn[ThreadId.xy] + InflowRate * DeltaTime;
}

// ---------------------------------------------------------------------------
// Pass 2: outflow flux through virtual pipes (x = left, y = right, z = down, w = up).
[numthreads(8, 8, 1)]
void ComputeFluxCS(uint3 ThreadId : SV_DispatchThreadID)
{
	if (ThreadId.x >= GridSize.x || ThreadId.y >= GridSize.y)
	{
		return;
	}
	const int2 Cell = int2(ThreadId.xy);
	const float SurfaceHeight = TerrainIn[Cell] + WaterIn[Cell];
	const float4 OldFlux = FluxIn[Cell];

	float4 NewFlux;
	UNROLL
	for (int Dir = 0; Dir < 4; ++Dir)
	{
		const int2 Neighbor = Cell + NeighborOffsets[Dir];
		float HeightDifference;
		if (IsInside(Neighbor))
		{
			HeightDifference = SurfaceHeight - (TerrainIn[Neighbor] + WaterIn[Neighbor]);
		}
		else
		{
			// Open boundary: water drains off the map edge.
			HeightDifference = WaterIn[Cell];
		}
		const float Accelerated = OldFlux[Dir] * FluxDamping + DeltaTime * PipeCrossSection * Gravity * HeightDifference / CellSizeMeters;
		NewFlux[Dir] = max(0.0f, Accelerated);
	}

	// Scale down so total outflow never exceeds the water in the cell.
	const float TotalOutflow = NewFlux.x + NewFlux.y + NewFlux.z + NewFlux.w;
	const float WaterVolume = WaterIn[Cell] * CellSizeMeters * CellSizeMeters;
	if (TotalOutflow * DeltaTime > WaterVolume && TotalOutflow > 0.0f)
	{
		NewFlux *= WaterVolume / (TotalOutflow * DeltaTime);
	}
	FluxOut[Cell] = NewFlux;
}

// ---------------------------------------------------------------------------
// Pass 3: water level and velocity from flux divergence.
[numthreads(8, 8, 1)]
void UpdateWaterCS(uint3 ThreadId : SV_DispatchThreadID)
{
	if (ThreadId.x >= GridSize.x || ThreadId.y >= GridSize.y)
	{
		return;
	}
	const int2 Cell = int2(ThreadId.xy);
	const float4 Outflow = FluxIn[Cell];

	float4 Inflow = float4(0, 0, 0, 0);
	// Inflow from left neighbor's right pipe, right neighbor's left pipe, etc.
	const int2 LeftCell = Cell + NeighborOffsets[0];
	const int2 RightCell = Cell + NeighborOffsets[1];
	const int2 DownCell = Cell + NeighborOffsets[2];
	const int2 UpCell = Cell + NeighborOffsets[3];
	Inflow.x = IsInside(LeftCell) ? FluxIn[LeftCell].y : 0.0f;
	Inflow.y = IsInside(RightCell) ? FluxIn[RightCell].x : 0.0f;
	Inflow.z = IsInside(DownCell) ? FluxIn[DownCell].w : 0.0f;
	Inflow.w = IsInside(UpCell) ? FluxIn[UpCell].z : 0.0f;

	const float CellArea = CellSizeMeters * CellSizeMeters;
	const float TotalInflow = Inflow.x + Inflow.y + Inflow.z + Inflow.w;
	const float TotalOutflow = Outflow.x + Outflow.y + Outflow.z + Outflow.w;
	const float OldWater = WaterIn[Cell];
	const float NewWater = max(0.0f, OldWater + DeltaTime * (TotalInflow - TotalOutflow) / CellArea);
	WaterOut[Cell] = NewWater;

	// Average water flow through the cell per axis drives sediment transport.
	const float FlowX = 0.5f * (Inflow.x - Outflow.x + Outflow.y - Inflow.y);
	const float FlowY = 0.5f * (Inflow.z - Outflow.z + Outflow.w - Inflow.w);
	const float AverageDepth = max(MinFlowDepth, 0.5f * (OldWater + NewWater));
	float2 Velocity = float2(FlowX, FlowY) / (AverageDepth * CellSizeMeters);
	const float Speed = length(Velocity);
	if (Speed > MaxWaterSpeed)
	{
		Velocity *= MaxWaterSpeed / Speed;
	}
	VelocityOut[Cell] = Velocity;
}

// ---------------------------------------------------------------------------
// Pass 4: erosion / deposition against transport capacity.
// Writes the signed exchange (positive eroded, negative deposited) instead of
// touching the terrain; ApplyErosionCS spreads it through the brush.

/** Slope sine from central differences of terrain height. */
float LocalSlopeSine(int2 Cell)
{
	const int2 LeftCell = int2(max(Cell.x - 1, 0), Cell.y);
	const int2 RightCell = int2(min(Cell.x + 1, (int)GridSize.x - 1), Cell.y);
	const int2 DownCell = int2(Cell.x, max(Cell.y - 1, 0));
	const int2 UpCell = int2(Cell.x, min(Cell.y + 1, (int)GridSize.y - 1));
	const float GradientX = (TerrainIn[RightCell] - TerrainIn[LeftCell]) / (2.0f * CellSizeMeters);
	const float GradientY = (TerrainIn[UpCell] - TerrainIn[DownCell]) / (2.0f * CellSizeMeters);
	const float GradientLengthSquared = GradientX * GradientX + GradientY * GradientY;
	return sqrt(GradientLengthSquared) / sqrt(1.0f + GradientLengthSquared);
}

/**
 * Fades erosion out towards the map border. The border ramp is an artificial
 * even slope that has no valleys to gather into, so leaving it in the
 * simulation just combs it into rills.
 */
float EdgeFade(int2 Cell)
{
	const int2 BorderDistance = min(Cell, int2(GridSize) - 1 - Cell);
	const float NearestBorder = (float)min(BorderDistance.x, BorderDistance.y);
	return saturate(NearestBorder / max(1.0f, ErosionEdgeFadeCells));
}

/**
 * How far this cell may be cut down before it becomes a local minimum. Water
 * pools in any pit it digs and then keeps digging it, so bounding erosion by
 * the drop to the lowest neighbour is what keeps flat ground flat.
 */
float ErosionHeadroom(int2 Cell)
{
	const float Height = TerrainIn[Cell];
	float LowestNeighbor = Height;
	UNROLL
	for (int Dir = 0; Dir < 4; ++Dir)
	{
		const int2 Neighbor = Cell + NeighborOffsets[Dir];
		if (IsInside(Neighbor))
		{
			LowestNeighbor = min(LowestNeighbor, TerrainIn[Neighbor]);
		}
	}
	return 0.5f * (Height - LowestNeighbor);
}

[numthreads(8, 8, 1)]
void ErodeDepositCS(uint3 ThreadId : SV_DispatchThreadID)
{
	if (ThreadId.x >= GridSize.x || ThreadId.y >= GridSize.y)
	{
		return;
	}
	const int2 Cell = int2(ThreadId.xy);

	// Capacity scales with slope, flow speed and water depth, so still ponds and
	// dry cells carry nothing and drop whatever they hold. Below the channel
	// depth there is no capacity at all and the cell can only deposit.
	const float WaterDepth = WaterIn[Cell];
	const float ChannelFactor = saturate((WaterDepth - MinErosionWaterDepth) / max(1e-6f, MinErosionWaterDepth));
	const float Speed = length(VelocityIn[Cell]);
	const float Capacity = SedimentCapacityFactor * LocalSlopeSine(Cell) * Speed * WaterDepth * ChannelFactor * EdgeFade(Cell);

	const float OldSediment = SedimentIn[Cell];
	if (OldSediment < Capacity)
	{
		const float Dissolved = min(min(DissolveRate * (Capacity - OldSediment), MaxErosionPerStep), ErosionHeadroom(Cell));
		ExchangeOut[Cell] = Dissolved;
		SedimentOut[Cell] = OldSediment + Dissolved;
		return;
	}

	const float Deposited = min(DepositRate * (OldSediment - Capacity), MaxErosionPerStep);
	ExchangeOut[Cell] = -Deposited;
	SedimentOut[Cell] = OldSediment - Deposited;
}

// ---------------------------------------------------------------------------
// Pass 5: spread the eroded amount through the brush and apply it to the terrain.

/**
 * Erosion brush (Lague): taking material through a radius-weighted footprint
 * rather than from the single cell stops one-pixel pits, checkerboard patterns
 * and the rill combing that per-cell cutting produces on an even slope. Run as
 * two separable tent passes so the cost stays linear in the radius.
 */
float BrushWeight(int Step)
{
	return 1.0f - abs((float)Step) / (ErosionBrushRadius + 1.0f);
}

/** Tent over the raw exchange; deposition is spread as well, or it leaves per-cell bumps. */
float BlurExchangeHorizontal(int2 Cell)
{
	float Total = 0.0f;
	float WeightSum = 0.0f;
	for (int Step = -ErosionBrushRadius; Step <= ErosionBrushRadius; ++Step)
	{
		const int2 Sample = Cell + int2(Step, 0);
		if (IsInside(Sample))
		{
			Total += ExchangeIn[Sample] * BrushWeight(Step);
			WeightSum += BrushWeight(Step);
		}
	}
	return Total / WeightSum;
}

/** Second half of the separable brush. */
float BlurExchangeVertical(int2 Cell)
{
	float Total = 0.0f;
	float WeightSum = 0.0f;
	for (int Step = -ErosionBrushRadius; Step <= ErosionBrushRadius; ++Step)
	{
		const int2 Sample = Cell + int2(0, Step);
		if (IsInside(Sample))
		{
			Total += ExchangeBlurIn[Sample] * BrushWeight(Step);
			WeightSum += BrushWeight(Step);
		}
	}
	return Total / WeightSum;
}

[numthreads(8, 8, 1)]
void BlurErosionCS(uint3 ThreadId : SV_DispatchThreadID)
{
	if (ThreadId.x >= GridSize.x || ThreadId.y >= GridSize.y)
	{
		return;
	}
	ExchangeOut[ThreadId.xy] = BlurExchangeHorizontal(int2(ThreadId.xy));
}

[numthreads(8, 8, 1)]
void ApplyErosionCS(uint3 ThreadId : SV_DispatchThreadID)
{
	if (ThreadId.x >= GridSize.x || ThreadId.y >= GridSize.y)
	{
		return;
	}
	const int2 Cell = int2(ThreadId.xy);
	TerrainOut[Cell] = TerrainIn[Cell] - BlurExchangeVertical(Cell);
}

// ---------------------------------------------------------------------------
// Pass 6: semi-Lagrangian sediment advection.
[numthreads(8, 8, 1)]
void AdvectSedimentCS(uint3 ThreadId : SV_DispatchThreadID)
{
	if (ThreadId.x >= GridSize.x || ThreadId.y >= GridSize.y)
	{
		return;
	}
	const int2 Cell = int2(ThreadId.xy);
	const float2 Velocity = VelocityIn[Cell];
	const float2 SourcePosition = float2(Cell) - Velocity * DeltaTime / CellSizeMeters;

	const int2 Base = int2(floor(SourcePosition));
	const float2 Fraction = SourcePosition - float2(Base);
	float Total = 0.0f;
	float WeightSum = 0.0f;
	UNROLL
	for (int OffsetY = 0; OffsetY <= 1; ++OffsetY)
	{
		UNROLL
		for (int OffsetX = 0; OffsetX <= 1; ++OffsetX)
		{
			const int2 Sample = Base + int2(OffsetX, OffsetY);
			if (!IsInside(Sample))
			{
				continue;
			}
			const float Weight = (OffsetX ? Fraction.x : 1.0f - Fraction.x) * (OffsetY ? Fraction.y : 1.0f - Fraction.y);
			Total += SedimentIn[Sample] * Weight;
			WeightSum += Weight;
		}
	}
	SedimentOut[Cell] = WeightSum > 0.0f ? Total / WeightSum : 0.0f;
}

// ---------------------------------------------------------------------------
// Pass 7: evaporation.
[numthreads(8, 8, 1)]
void EvaporateCS(uint3 ThreadId : SV_DispatchThreadID)
{
	if (ThreadId.x >= GridSize.x || ThreadId.y >= GridSize.y)
	{
		return;
	}
	WaterOut[ThreadId.xy] = WaterIn[ThreadId.xy] * max(0.0f, 1.0f - EvaporationRate * DeltaTime);
}

// ---------------------------------------------------------------------------
// Thermal pass A: material outflow to lower neighbors past the talus angle.
[numthreads(8, 8, 1)]
void ThermalFluxCS(uint3 ThreadId : SV_DispatchThreadID)
{
	if (ThreadId.x >= GridSize.x || ThreadId.y >= GridSize.y)
	{
		return;
	}
	const int2 Cell = int2(ThreadId.xy);
	const float Height = TerrainIn[Cell];

	float4 Outflow = float4(0, 0, 0, 0);
	float TotalDrop = 0.0f;
	float MaxDrop = 0.0f;
	UNROLL
	for (int Dir = 0; Dir < 4; ++Dir)
	{
		const int2 Neighbor = Cell + NeighborOffsets[Dir];
		if (!IsInside(Neighbor))
		{
			continue;
		}
		const float Drop = Height - TerrainIn[Neighbor];
		if (Drop > TalusTangent * CellSizeMeters)
		{
			Outflow[Dir] = Drop;
			TotalDrop += Drop;
			MaxDrop = max(MaxDrop, Drop);
		}
	}
	if (TotalDrop > 0.0f)
	{
		// Move a fraction of the largest over-talus drop per step, split by drop size.
		// Independent of the hydraulic time step; ThermalRate < 1 keeps it stable.
		const float MovedVolume = ThermalRate * 0.5f * (MaxDrop - TalusTangent * CellSizeMeters);
		Outflow *= MovedVolume / TotalDrop;
	}
	FluxOut[Cell] = Outflow;
}

// ---------------------------------------------------------------------------
// Thermal pass B: apply thermal in/outflow.
[numthreads(8, 8, 1)]
void ThermalApplyCS(uint3 ThreadId : SV_DispatchThreadID)
{
	if (ThreadId.x >= GridSize.x || ThreadId.y >= GridSize.y)
	{
		return;
	}
	const int2 Cell = int2(ThreadId.xy);
	const float4 Outflow = FluxIn[Cell];

	float Inflow = 0.0f;
	const int2 LeftCell = Cell + NeighborOffsets[0];
	const int2 RightCell = Cell + NeighborOffsets[1];
	const int2 DownCell = Cell + NeighborOffsets[2];
	const int2 UpCell = Cell + NeighborOffsets[3];
	Inflow += IsInside(LeftCell) ? FluxIn[LeftCell].y : 0.0f;
	Inflow += IsInside(RightCell) ? FluxIn[RightCell].x : 0.0f;
	Inflow += IsInside(DownCell) ? FluxIn[DownCell].w : 0.0f;
	Inflow += IsInside(UpCell) ? FluxIn[UpCell].z : 0.0f;

	const float TotalOutflow = Outflow.x + Outflow.y + Outflow.z + Outflow.w;
	TerrainOut[Cell] = TerrainIn[Cell] + Inflow - TotalOutflow;
}
